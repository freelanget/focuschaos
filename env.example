# Copy this file to ".env" (same folder) and fill in your real values.
# ".env" must NEVER be committed to GitHub — it's already in .gitignore.
#
# These two are read by /api/generate-steps.js on the server side only.
# The browser never sees them.

YANDEX_API_KEY=your_secret_key_here
YANDEX_FOLDER_ID=your_folder_id_here
